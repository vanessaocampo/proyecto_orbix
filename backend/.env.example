# =========================================================
# ORBIX - Variables de entorno (copia este archivo a .env)
# =========================================================

# Conexión a PostgreSQL (Neon). Reemplaza con tus credenciales reales.
DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/nombre_bd?sslmode=require

# Puerto del servidor HTTP
PORT=3000

# Secreto para firmar los JWT. Usa una cadena larga y aleatoria en producción.
JWT_SECRET=orbix_secret_dev_change_me
# Tiempo de expiración del token (formato de jsonwebtoken)
JWT_EXPIRES_IN=8h
